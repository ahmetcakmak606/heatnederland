---
import { useTranslations } from '../i18n/utils';
import { getAssetPath } from '../utils/paths';

const lang = Astro.currentLocale || 'nl';
const t = useTranslations(lang);
---

<section id="contact" class="scroll-section min-h-screen bg-gray-50 pt-24">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center">
      <!-- Remove the main <h2> heading since nav now highlights section. -->
    </div>

    <!-- Main Content -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <h3 class="text-2xl font-semibold mb-4">{t('contact.getInTouch')}</h3>
        <div class="space-y-4">
          <p><strong>{t('contact.address')}:</strong><br />Beresteinlaan 349, 2542 JJ Den Haag</p>
          <p><strong>{t('contact.phone')}:</strong><br /><a href="tel:+31653212687" class="text-blue-600 hover:underline">+31 6 53212687</a></p>
          <p><strong>{t('contact.email')}:</strong><br /><a href="mailto:alikaya@heatnederland.nl" class="text-blue-600 hover:underline">alikaya@heatnederland.nl</a></p>
        </div>
        
        <!-- Add Certificates -->
        <div class="flex flex-wrap gap-4 mt-8">
          <img 
            src={getAssetPath('/images/certificates/cert1.jpeg')}
            alt="KIWA Certification" 
            class="h-24 object-contain"
          />
          <img 
            src={getAssetPath('/images/certificates/cert2.jpeg')}
            alt="CO2 Free Certification" 
            class="h-24 object-contain"
          />
          <img 
            src={getAssetPath('/images/certificates/cert3.png')}
            alt="Lid van Techniek Nederland" 
            class="h-24 object-contain"
          />
          <img 
            src={getAssetPath('/images/certificates/cert4.png')}
            alt="KIWA F-Gassen Certification" 
            class="h-24 object-contain"
          />
        </div>
      </div>
      <div class="rounded-lg overflow-hidden h-[400px]">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2470.161990403366!2d4.283475776941784!3d52.03324197196893!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47c5b5c3d9272c45%3A0x37db6f3b4e2a663b!2sBeresteinlaan%20349%2C%202542%20JJ%20Den%20Haag!5e0!3m2!1sen!2snl!4v1705247161099!5m2!1sen!2snl"
          width="100%"
          height="100%"
          style="border:0;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </div>
</section> 
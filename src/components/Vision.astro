---
import { useTranslations } from '../i18n/utils';

const lang = Astro.currentLocale || 'nl';
const t = useTranslations(lang);
---

<section id="vision" class="scroll-section bg-gray-50 min-h-screen flex items-center justify-center pt-28 pb-16">
  <div class="max-w-4xl mx-auto px-4">
    <div class="prose prose-lg mx-auto text-gray-600">
      <p>{t('vision.text')}</p>
    </div>
  </div>
</section>

<style>
  .prose {
    max-width: 65ch;
    line-height: 1.8;
  }
</style> 
---
import { useTranslations } from '../i18n/utils';

const lang = Astro.currentLocale || 'nl';
const t = useTranslations(lang);
---

<section id="vision" class="bg-gray-50 py-16 mb-16 scroll-section">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="text-3xl font-bold text-center mb-8 text-gray-800">{t('vision.title')}</h2>
    <div class="prose prose-lg mx-auto text-gray-600">
      <p>{t('vision.text')}</p>
    </div>
  </div>
</section>

<style>
  .prose {
    max-width: 65ch;
    line-height: 1.8;
  }
</style> 
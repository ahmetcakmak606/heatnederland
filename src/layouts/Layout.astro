---
import "../styles/global.css";
import { getLanguageFromURL, useTranslations } from '../i18n/utils';
import '../styles/colors.css';
import { getAssetPath } from '../utils/paths';

interface Props {
  title?: string;
}

const { title = "HeatNederland - Uw Comfort is Onze Prioriteit" } = Astro.props;
const currentLocale = Astro.currentLocale || 'nl';
const t = useTranslations(currentLocale);

const navItems = [
  { id: 'home', label: t('nav.home') },
  { id: 'airco', label: t('services.airco.title') },
  { id: 'warmtepomp', label: t('services.warmtepomp.title') },
  { id: 'heating', label: t('services.heating.title') },
  { id: 'verwarminginstallatie', label: t('services.verwarminginstallatie.title') },
  { id: 'vision', label: t('vision.title') },
  { id: 'contact', label: t('nav.contact') },
];

const languageLinks = [
  { code: 'nl', href: getAssetPath('/'), label: 'NL' },
  { code: 'en', href: getAssetPath('/en'), label: 'EN' },
  { code: 'tr', href: getAssetPath('/tr'), label: 'TR' }
];
---

<!DOCTYPE html>
<html lang={currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={getAssetPath('/favicon.svg')} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="HeatNederland - Professionele installatie van airconditioning, warmtepomp, verwarming en verwarminginstallatie." />
    <!-- Force reload CSS to avoid caching issues -->
    <link rel="stylesheet" href={getAssetPath('/styles/global.css')} />
    <title>{title}</title>
  </head>
  <body>
    <nav class="fixed w-full bg-[var(--primary-bg)] shadow-lg z-50">
      <div class="max-w-7xl mx-auto px-4">
        <div class="flex justify-between h-24">
          <div class="flex-shrink-0 flex items-center">
            <a href={getAssetPath('/')} class="flex items-center">
              <img 
                src={getAssetPath('/images/logos/logo4.jpeg')}
                alt="HeatNederland" 
                class="h-20 object-contain"
              />
            </a>
          </div>
          <div class="hidden md:flex items-center space-x-4 py-2">
            {navItems.map(item => (
              <a 
                href={`#${item.id}`} 
                class="nav-link px-3 py-2 text-[var(--primary-white)] hover:text-[var(--primary-red)] transition-colors"
              >
                {item.label}
              </a>
            ))}
            <div class="flex space-x-2">
              {languageLinks.map(({ code, href, label }) => (
                <a
                  href={href}
                  class={`px-2 py-1 rounded ${
                    currentLocale === code 
                      ? 'bg-[var(--primary-red)] text-[var(--primary-white)]' 
                      : 'text-[var(--primary-white)] hover:text-[var(--primary-red)]'
                  }`}
                >
                  {label}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </nav>

    <!-- Navigation Dots -->
    <div class="fixed right-4 top-1/2 transform -translate-y-1/2 z-50 space-y-2">
      {navItems.map(item => (
        <a
          href={`#${item.id}`}
          class="nav-dot block w-3 h-3 rounded-full bg-white border-2 border-blue-600 hover:bg-blue-600 transition-colors"
          title={item.label}
        />
      ))}
    </div>

    <div class="scroll-container">
      <slot />
    </div>
  </body>
</html>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const sections = document.querySelectorAll('.scroll-section');
    const navLinks = document.querySelectorAll('nav .nav-link');
    const navDots = document.querySelectorAll('.nav-dot');

    const activateNav = (id) => {
      navLinks.forEach(link => {
        link.classList.toggle('active', link.getAttribute('href') === `#${id}`);
      });
      navDots.forEach(dot => {
        dot.classList.toggle('active', dot.getAttribute('href') === `#${id}`);
      });
    };

    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.5,
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          activateNav(entry.target.id);
        }
      });
    }, observerOptions);

    sections.forEach(section => observer.observe(section));
  });
</script>

<style>
  .scroll-container {
    height: 100vh;
    overflow-y: scroll;
    scroll-snap-type: y mandatory;
    scroll-behavior: smooth;
  }
  nav {
    font-size: 1rem;
    padding-top: 0.25rem;
    padding-bottom: 0.25rem;
  }
  .nav-link.active {
    font-weight: 700;
    color: var(--primary-red);
  }
  .nav-dot.active {
    background: var(--primary-red);
  }
  .md\:flex.items-center.space-x-4.py-2 > a {
    font-size: 1rem;
    padding: 0.25rem 0.75rem;
  }
  .md\:flex.items-center.space-x-4.py-2 > .flex.space-x-2 > a {
    font-size: 0.95rem;
    padding: 0.15rem 0.5rem;
  }
</style>
---
import "../styles/global.css";
import { getLanguageFromURL, useTranslations } from '../i18n/utils';
import '../styles/colors.css';
import { getAssetPath } from '../utils/paths';

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentLocale = Astro.currentLocale || 'nl';
const t = useTranslations(currentLocale);

const navItems = [
  { id: 'home', label: t('nav.home') },
  { id: 'airco', label: t('services.airco.title') },
  { id: 'badkamer', label: t('services.badkamer.title') },
  { id: 'heating', label: t('services.heating.title') },
  { id: 'vloerverwarming', label: t('services.vloerverwarming.title') },
  { id: 'contact', label: t('nav.contact') },
];

const languageLinks = [
  { code: 'nl', href: getAssetPath('/'), label: 'NL' },
  { code: 'en', href: getAssetPath('/en'), label: 'EN' },
  { code: 'tr', href: getAssetPath('/tr'), label: 'TR' }
];
---

<!DOCTYPE html>
<html lang={currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={getAssetPath('/favicon.svg')} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <nav class="fixed w-full bg-[var(--primary-bg)] shadow-lg z-50">
      <div class="max-w-7xl mx-auto px-4">
        <div class="flex justify-between h-24">
          <div class="flex-shrink-0 flex items-center">
            <a href={getAssetPath('/')} class="flex items-center">
              <img 
                src={getAssetPath('/images/logos/logo4.jpeg')}
                alt="HeatNederland" 
                class="h-20 object-contain"
              />
            </a>
          </div>
          <div class="hidden md:flex items-center space-x-4 py-2">
            {navItems.map(item => (
              <a 
                href={`#${item.id}`} 
                class="px-3 py-2 text-[var(--primary-white)] hover:text-[var(--primary-red)] transition-colors"
              >
                {item.label}
              </a>
            ))}
            <div class="flex space-x-2">
              {languageLinks.map(({ code, href, label }) => (
                <a
                  href={href}
                  class={`px-2 py-1 rounded ${
                    currentLocale === code 
                      ? 'bg-[var(--primary-red)] text-[var(--primary-white)]' 
                      : 'text-[var(--primary-white)] hover:text-[var(--primary-red)]'
                  }`}
                >
                  {label}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </nav>

    <!-- Navigation Dots -->
    <div class="fixed right-4 top-1/2 transform -translate-y-1/2 z-50 space-y-2">
      {navItems.map(item => (
        <a
          href={`#${item.id}`}
          class="block w-3 h-3 rounded-full bg-white border-2 border-blue-600 hover:bg-blue-600 transition-colors"
          title={item.label}
        />
      ))}
    </div>

    <div class="scroll-container">
      <slot />
    </div>
  </body>
</html>

<style>
  .scroll-container {
    height: 100vh;
    overflow-y: scroll;
    scroll-snap-type: y mandatory;
    scroll-behavior: smooth;
  }
</style>